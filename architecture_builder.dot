digraph WormReconstruction {
    rankdir=TB;
    node [shape=box, style=rounded, fontsize=12, fontname="Arial", height=0.8, width=2.5];
    edge [fontsize=11, fontname="Arial"];
    
    subgraph cluster_legend {
        label="Legend";
        style="filled";
        fillcolor="whitesmoke";
        rank="source";
        LegendNew [label="New Head and Tail (HT)\n Components", style="filled", fillcolor="#D4F1D4", shape="box"];
        LegendModified [label="Modified Components", style="filled", fillcolor="#CCE7FF", shape="box"];
        LegendOptional [label="Optional (HT disabled)", style="dashed", shape="box"];
        LegendNew -> LegendModified -> LegendOptional [style="invis"];
    }
    
    // Input Configuration
    Args [label="Configuration\n(RuntimeArgs, ParameterArgs, SourceArgs,\nHeadAndTailOptimizationArgs)",style="filled,rounded", fillcolor="#CCE7FF"];
    Trial [label="Trial\n(Multi-camera videos)"];
    HTCoordinates [label="Head & Tail Coordinates\n(Ground truth CSV dataset)", style="filled,rounded", fillcolor="#CCE7FF"];
    
    // Core Processing
    Midline3DFinder [label="Midline3DFinder\n(Main optimisation engine\nwith HT integration)",  style="filled,rounded", fillcolor="#CCE7FF"];
    ProjectRenderScoreModel [label="ProjectRenderScoreModel\n(3D→2D projection & scoring)"];
    
    // Head & Tail Components
    HTLossCalculator [label="Head & Tail Loss Calculator\n(Distance-based penalties:\nL1, L2)", style="filled,rounded", fillcolor="#D4F1D4"];
    ConvergenceDetector [label="Convergence Detector\n(Triggers HT optimisation)", style="filled,rounded", fillcolor="#CCE7FF"];
    
    // State Management
    TrialState [label="TrialState\n(Cross-frame coordination)"];
    FrameState [label="FrameState\n(Per-frame parameters)"];
    
    // Database Models
    MFParameters [label="MFParameters\n(Optimisation config)"];
    HTParameters [label="HTParameters\n(HT specific config)", style="filled,rounded", fillcolor="#D4F1D4"];
    
    // Output
    Reconstruction [label="Reconstruction\n(3D midline results +\nHT validation plots)", style="filled,rounded", fillcolor="#CCE7FF"];
    MFCheckpoint [label="MFCheckpoint\n(Training progress)"];
    MongoDB [label="MongoDB\n(Database storage)"];
    DiskStorage [label="Disk Storage\n(Large reconstruction data +\nHT comparison plots)", style="filled,rounded", fillcolor="#CCE7FF"];
    
    // Main flow connections
    Args -> Midline3DFinder;
    HTCoordinates -> Args [label="loaded if enabled"];
    Trial -> TrialState;
    TrialState -> FrameState;
    FrameState -> Midline3DFinder;
    
    // Core optimisation loop
    Midline3DFinder -> ProjectRenderScoreModel;
    ProjectRenderScoreModel -> Midline3DFinder [label="optimisation loop"];
    
    // Head & Tail integration
    HTCoordinates -> HTLossCalculator [style="dashed"];
    HTLossCalculator -> Midline3DFinder [label="HT loss"];
    Midline3DFinder -> ConvergenceDetector [label="loss metrics"];
    ConvergenceDetector -> Midline3DFinder [label="convergence signal"];
    
    // Parameter configuration
    Args -> MFParameters [label="creates"];
    Args -> HTParameters [label="creates if HT enabled", style="dashed"];
    MFParameters -> Midline3DFinder;
    HTParameters -> Midline3DFinder [style="dashed"];
    
    // Output connections
    Midline3DFinder -> Reconstruction;
    Midline3DFinder -> MFCheckpoint;
    Reconstruction -> MongoDB;
    MFCheckpoint -> MongoDB;
    HTParameters -> MongoDB [style="dashed"];
    Reconstruction -> DiskStorage [label=" large data"];
}
