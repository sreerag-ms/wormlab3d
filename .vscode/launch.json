      "args": [
      "--reconstruction=688f40835273814a3dfc013d",
      "--frame-num=4779",
      "--user=YO"
      ],
      "env": {
        "PYTHONPATH": "/Users/sreeragms/Documents/uol/msc-project-repos/wormlab3d:${env:PYTHONPATH}"
      },
      "console": "integratedTerminal"
